# Variáveis essenciais (sem valores reais — copie para .env e preencha)
SECRET_KEY=
DEBUG=True
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL em produção (Render, Supabase, etc.): cole DATABASE_URL do painel.
# SSL é activado automaticamente para hosts cloud e DJANGO_ENV=prod.
# Para forçar manualmente: DATABASE_SSL_REQUIRE=True

# Ambiente Django: dev | prod (core/settings/__init__.py)
DJANGO_ENV=dev

# Modo demonstração: e-mails no console, WhatsApp/Mercado Pago desativados.
# A demo usa SQLite e recria a base a cada arranque (start.sh); seed_demo exige DEMO_MODE=True.
DEMO_MODE=False
DEMO_DB_PATH=db.sqlite3
DEMO_SEED_PASSWORD=demo12345
DEMO_ADMIN_PASSWORD=demo12345

# Compatibilidade (opcional): se preferir estes nomes em vez de SECRET_KEY / DEBUG / ALLOWED_HOSTS
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=
# DJANGO_ALLOWED_HOSTS=

# Cross-origin resource sharing
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Logging
DJANGO_LOG_LEVEL=INFO

# Email and external
DEFAULT_FROM_EMAIL=noreply@localhost
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
API_RATE_LIMIT_ANON=120/hour
API_RATE_LIMIT_USER=1200/hour
API_RATE_LIMIT_CONTACT=10/hour
API_RATE_LIMIT_CHECKOUT=30/hour
